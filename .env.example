# Clés publiques Firebase (Console > Paramètres du projet > Vos applications > Web)
# Elles finissent dans le bundle navigateur : ce n'est pas un secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# SECRET — accès admin complet au projet Firebase.
# Console > Paramètres > Comptes de service > Générer une nouvelle clé privée.
# Coller le JSON entier sur UNE SEULE ligne. Ne jamais commiter.
FIREBASE_SERVICE_ACCOUNT=
